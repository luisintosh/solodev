{
  "name": "solodev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Spec-driven development harness for Claude Code, Codex, and Cursor — role skills, transpile, solodev CLI.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run src/cli/ tools/",
    "transpile": "node tools/transpile.ts",
    "build:cli": "node tools/build-cli.ts",
    "build": "node tools/transpile.ts && node tools/build-cli.ts",
    "check": "node tools/check.ts",
    "release": "node tools/release.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write . && prettier --write \"**/*.{md,yaml,yml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,yaml,yml}\"",
    "eval:quiz": "node tools/quiz.ts",
    "eval:validate": "node tools/eval-stage.ts validate",
    "eval:stage": "node tools/eval-stage.ts run"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.25.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18"
    }
  }
}
