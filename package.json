{
  "name": "solodev",
  "private": true,
  "type": "module",
  "description": "Spec-driven development harness for Claude Code, Codex, and Cursor — role skills, transpile, solodev CLI.",
  "bin": {
    "solodev": "./bin/install.js"
  },
  "files": [
    "bin/install.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run src/cli/ tools/",
    "transpile": "node tools/transpile.ts",
    "build:cli": "node tools/build-cli.ts",
    "build:install": "node tools/build-install.ts",
    "gen-manifest": "node tools/gen-manifest.ts",
    "build": "node tools/transpile.ts && node tools/build-cli.ts && node tools/gen-manifest.ts && node tools/build-install.ts",
    "check": "node tools/check.ts",
    "release": "node tools/release.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write . && prettier --write \"**/*.{md,yaml,yml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,yaml,yml}\"",
    "eval:validate": "node tools/eval.ts validate && node tools/eval-stage.ts validate",
    "eval:smoke": "pnpm test && node tools/eval-stage.ts run --tier smoke",
    "eval:stage": "node tools/eval-stage.ts run",
    "eval:changed": "node tools/eval-stage.ts run --changed",
    "eval:full": "node tools/eval.ts run --config v2-claude"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "yaml": "^2.9.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.25.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18"
    }
  }
}
